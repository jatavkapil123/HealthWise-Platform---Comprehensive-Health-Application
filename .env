# HealthWise Microservices Environment Configuration

# API Gateway
API_GATEWAY_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Database Configuration
MONGODB_URI=mongodb://admin:password@mongodb:27017/healthwise?authSource=admin
POSTGRES_URI=postgresql://postgres:password@postgres:5432/healthwise
REDIS_URL=redis://redis:6379

# External Services
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Communication Services
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Video Calling
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Cloud Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Maps & Location
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# InfluxDB Configuration
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=healthwise
INFLUXDB_BUCKET=health-data

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_TELEMEDICINE=true
ENABLE_IOT_INTEGRATION=true
ENABLE_COMMUNITY_FEATURES=true
ENABLE_ANALYTICS=true

# Environment
NODE_ENV=development
PYTHON_ENV=development